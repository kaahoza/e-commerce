USER_DB_PORT=5434
ORDER_DB_PORT=5435

GATEWAY_PORT=8080
PRODUCT_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083

# ---------- JWT ----------
